<div class="glow-top flex min-h-dvh flex-col px-6 py-8 sm:px-12">
  <span class="wordmark inline-flex items-center gap-2">
    <img src={~p"/images/logo-mark.webp"} alt="" class="size-7 mix-blend-screen" />
    <span>
      bullethub<span class="dot">.</span>
    </span>
  </span>

  <div class="mx-auto my-auto w-full max-w-sm py-12">
    <p class="kicker"><span class="diamond" />Painel administrativo</p>
    <h1 class="display mt-5 text-5xl">Entrar<span class="text-primary">.</span></h1>
    <p class="mt-3 text-muted">Acesso restrito a owner, editor e suporte.</p>

    <div
      :if={@error}
      role="alert"
      class="mt-8 flex gap-3 rounded-md border border-hairline bg-base-200 px-4 py-3 text-sm"
    >
      <span class="w-[3px] shrink-0 rounded-full bg-primary"></span>{@error}
    </div>

    <.form for={@form} id="admin-login-form" action={~p"/login"} class="mt-8 space-y-2">
      <.input field={@form[:email]} type="email" label="E-mail" autocomplete="username" required />
      <.input
        field={@form[:password]}
        type="password"
        label="Senha"
        autocomplete="current-password"
        required
      />
      <button type="submit" class="btn btn-accent-outline mt-4 w-full">
        Entrar <span aria-hidden="true">→</span>
      </button>
    </.form>
  </div>
</div>
