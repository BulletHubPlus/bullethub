# Copy into Coolify → Environment Variables. Never commit real values.
PHX_HOST=bullethub.app
ADMIN_HOST=admin.bullethub.app

# Coolify Postgres 16 resource (internal hostname on the coolify network)
DATABASE_URL=ecto://bullethub:CHANGE_ME@bullethub-db:5432/bullethub
POOL_SIZE=10

# mix phx.gen.secret
SECRET_KEY_BASE=
# 32 random bytes, base64: openssl rand -base64 32   (encrypts CPF at rest - back it up!)
CLOAK_KEY=
# Separate key for CPF uniqueness hash: openssl rand -hex 32   (never rotate without rehash)
CPF_HMAC_KEY=

# Bunny Stream → Library → API
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# Bunny Stream → Library → Security → Embed view token authentication key
BUNNY_EMBED_TOKEN_KEY=
# Read-only API key: Bunny signs webhooks with it (HMAC-SHA256 of the raw body)
BUNNY_READONLY_API_KEY=
# Library → Delivery → CDN hostname, e.g. vz-abc123.b-cdn.net (thumbnails)
BUNNY_CDN_HOSTNAME=
# Bunny → Stream → Library → Webhook URL: https://bullethub.app/webhooks/bunny

# Resend (transactional e-mail)
RESEND_API_KEY=
MAIL_FROM=no-reply@bullethub.app
